
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DJ BASHIRUG | The Mix Grandmaster</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #050914;
  color: white;
  font-family: Arial, sans-serif;
  line-height: 1.6;
}

header {
  background: #020611;
  padding: 22px 12px;
  text-align: center;
  border-bottom: 2px solid #008cff;
}

header h1 {
  color: #168dff;
  font-size: 32px;
  letter-spacing: 2px;
  text-shadow: 0 0 15px #008cff;
}

header p {
  color: white;
  letter-spacing: 3px;
  font-size: 13px;
}

nav {
  background: #07152b;
  padding: 14px 8px;
  text-align: center;
}

nav a {
  color: white;
  text-decoration: none;
  margin: 7px;
  font-weight: bold;
  display: inline-block;
}

nav a:hover {
  color: #00aaff;
}

.banner {
  overflow: hidden;
  white-space: nowrap;
  background: #006bd6;
  padding: 12px;
  font-weight: bold;
}

.banner span {
  display: inline-block;
  padding-left: 100%;
  animation: move 18s linear infinite;
}

@keyframes move {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
}

.hero {
  text-align: center;
  padding: 45px 15px;
  background: radial-gradient(circle, #10366b, #050914 70%);
}

.hero img {
  width: 190px;
  height: 190px;
  object-fit: cover;
  border-radius: 50%;
  border: 4px solid #008cff;
  box-shadow: 0 0 25px #008cff;
}

.hero h2 {
  font-size: 35px;
  margin-top: 20px;
  color: #168dff;
  text-shadow: 0 0 15px #008cff;
}

.hero h3 {
  color: #fff;
  letter-spacing: 3px;
}

.hero p {
  margin-top: 12px;
  color: #c8dcff;
}

section {
  padding: 40px 18px;
  text-align: center;
}

section h2 {
  color: #168dff;
  margin-bottom: 20px;
  text-shadow: 0 0 10px #005eff;
}

.panel {
  max-width: 750px;
  margin: 15px auto;
  padding: 25px;
  background: #0b1830;
  border: 1px solid #087cff;
  border-radius: 15px;
  box-shadow: 0 0 15px #003b80;
}

audio {
  width: 100%;
  margin-top: 15px;
}

.btn {
  display: inline-block;
  padding: 12px 22px;
  margin: 8px;
  border-radius: 25px;
  background: #087cff;
  color: white;
  text-decoration: none;
  font-weight: bold;
}

.btn:hover {
  background: #00aaff;
}

.connect-buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 18px;
  padding: 25px 10px;
}

.connect-btn {
  display: inline-block;
  padding: 16px 25px;
  border-radius: 30px;
  color: white;
  text-decoration: none;
  font-weight: bold;
  letter-spacing: 1px;
  box-shadow: 0 0 15px #008cff;
  transition: 0.3s;
}

.connect-btn:hover {
  transform: scale(1.05);
  box-shadow: 0 0 25px #00aaff;
}

.tiktok {
  background: #111;
  border: 2px solid #00f2ea;
}

.youtube {
  background: #e60000;
}

.whatsapp {
  background: #087f42;
}

input, textarea {
  width: 100%;
  padding: 13px;
  margin: 8px 0;
  border: 1px solid #168dff;
  border-radius: 8px;
  background: #07152b;
  color: white;
  font-size: 15px;
}

textarea {
  min-height: 100px;
}

button {
  border: none;
  cursor: pointer;
}

footer {
  background: #020611;
  padding: 22px 10px;
  text-align: center;
  border-top: 2px solid #087cff;
  color: #a9cfff;
}

@media (max-width: 600px) {
  header h1 {
    font-size: 25px;
  }

  .hero h2 {
    font-size: 28px;
  }

  nav a {
    font-size: 13px;
  }

  .connect-btn {
    width: 90%;
  }
}
  
</style>
</head>

<body>

<header>
  <h1>DJ BASHIRUG</h1>
  <p>THE MIX GRANDMASTER</p>
</header>

<div class="banner">
  <span>WELCOME TO THE OFFICIAL DJ BASHIRUG WEBSITE • MUSIC • ENTERTAINMENT • GOOD VIBES •</span>
</div>

<nav>
  <a href="#home">HOME</a>
  <a href="#about">ABOUT</a>
  <a href="#mixes">MIXTAPES</a>
  <a href="#booking">BOOKING</a>
  <a href="#contact">CONTACT</a>
</nav>

<section class="hero" id="home">
  <img src="dj-bashirug.jpg" alt="DJ BASHIRUG">

  <h2>DJ BASHIRUG</h2>
  <h3>THE MIX GRANDMASTER</h3>
  <p>Mix • Play • Enjoy</p>
  <p>Music Connects People...</p>
</section>

<section id="about">
  <h2>ABOUT DJ BASHIRUG</h2>
  <div class="panel">
    <p>
      Welcome to the official website of DJ BASHIRUG.
      Your destination for nonstop mixes, great music,
      entertainment and unforgettable party vibes.
    </p>
  </div>
</section>

<section id="mixes">
  <h2>DJ BASHIRUG MIXTAPES</h2>

  <div class="panel">
    <h3>MY LATEST NONSTOP MIX</h3>
    <p>Listen to the latest DJ BASHIRUG mix below.</p>

    <audio controls>
      <source src="mix.mp3" type="audio/mpeg">
      Your browser does not support audio.
    </audio>
  </div>
</section>

<section id="booking">
  <h2>BOOK DJ BASHIRUG</h2>

  <div class="panel">
    <p>For events, parties and entertainment, send a booking request.</p>

    <form onsubmit="sendBooking(event)">
      <input type="text" id="name" placeholder="Your Name" required>

      <input type="text" id="event" placeholder="Type of Event" required>

      <input type="date" id="date" required>

      <textarea id="message" placeholder="Your Message"></textarea>

      <button type="submit" class="btn">
        SEND BOOKING REQUEST
      </button>
    </form>
  </div>
</section>

<section id="contact">
  <h2>CONNECT WITH DJ BASHIRUG</h2>

  <div class="connect-buttons">

    <a href="https://www.tiktok.com/@www.dj.bashirug"
       class="connect-btn tiktok" target="_blank">
       ♪ FOLLOW ME ON TIKTOK
    </a>

    <a href="https://youtube.com/@hectorhabib"
       class="connect-btn youtube" target="_blank">
       ▶ SUBSCRIBE ON YOUTUBE
    </a>

    <a href="https://wa.me/256769484802"
       class="connect-btn whatsapp" target="_blank">
       ☎ CONNECT ON WHATSAPP
    </a>

  </div>
</section>

<footer>
  <p>© 2026 DJ BASHIRUG. All Rights Reserved.</p>
  <p>Music • Entertainment • Good Vibes</p>
  <p>Designed in Uganda 🇺🇬</p>
</footer>

<script>
function sendBooking(event) {
  event.preventDefault();

  const name = document.getElementById("name").value;
  const eventType = document.getElementById("event").value;
  const date = document.getElementById("date").value;
  const message = document.getElementById("message").value;

  const text =
    "Hello DJ BASHIRUG! I want to make a booking.%0A" +
    "Name: " + encodeURIComponent(name) + "%0A" +
    "Event: " + encodeURIComponent(eventType) + "%0A" +
    "Date: " + encodeURIComponent(date) + "%0A" +
    "Message: " + encodeURIComponent(message);

  window.open(
    "https://wa.me/256769484802?text=" + text,
    "_blank"
  );
}
</script>

</body>
</html>
